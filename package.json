{
  "name": "redifinch",
  "productName": "RediFinch",
  "version": "0.1.10",
  "private": true,
  "description": "Voice dictation, translation, and a browser-assisted desktop agent for Windows.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build:electron": "node scripts/build-electron.mjs",
    "build:next": "next build",
    "build": "npm run build:electron && npm run build:next",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test:keys": "node scripts/test-keymatch.mjs",
    "test:output": "node scripts/test-output.mjs",
    "test:models": "node scripts/test-model-catalog.mjs",
    "test:speko": "node scripts/test-speko.mjs",
    "test:groq": "node scripts/test-groq.mjs",
    "test:agent": "node scripts/test-agent-runner.mjs",
    "test:chrome": "node scripts/test-chrome-mcp.mjs",
    "models:download": "node scripts/download-models.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "chrome-devtools-mcp": "^1.10.1",
    "koffi": "^3.3.2",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.469.0",
    "next": "^16.4.0",
    "postcss": "^8.4.49",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "koffi@3.3.2": true
  }
}
